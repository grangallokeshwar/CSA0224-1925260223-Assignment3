include <stdio.h>
#include <stdlib.h>
#define MAXN 10000
typedef struct { long comparisons, swaps, shifts; } Stats;
void bubble(int a[],int n,Stats *s){for(int i=0;i<n-1;i++){int changed=0;for(int j=0;j<n-1-i;j++){s->comparisons++;if(a[j]>a[j+1]){int t=a[j];a[j]=a[j+1];a[j+1]=t;s->swaps++;changed=1;}}if(!changed)break;}}
void selection(int a[],int n,Stats *s){for(int i=0;i<n-1;i++){int m=i;for(int j=i+1;j<n;j++){s->comparisons++;if(a[j]<a[m])m=j;}if(m!=i){int t=a[i];a[i]=a[m];a[m]=t;s->swaps++;}}}
void insertion(int a[],int n,Stats *s){for(int i=1;i<n;i++){int key=a[i],j=i-1;while(j>=0){s->comparisons++;if(a[j]>key){a[j+1]=a[j];s->shifts++;j--;}else break;}a[j+1]=key;}}
void make(int *a,int n,int mode){for(int i=0;i<n;i++)a[i]=i+1;if(mode==1){for(int i=0;i<n/20;i++){int x=n-1-i;a[x]=x+1; a[x]=a[x];} if(n>1){int t=a[n/2];a[n/2]=a[n/2-1];a[n/2-1]=t;}}else if(mode==2){for(int i=0;i<n;i++)a[i]=n-i;}else if(mode==3){for(int i=n-1;i>0;i--){int j=rand()%(i+1),t=a[i];a[i]=a[j];a[j]=t;}}}
int main(void){const char *names[]={"sorted","nearly","reverse","random"};int *src=malloc(MAXN*sizeof(int)),*a=malloc(MAXN*sizeof(int));if(!src||!a)return 1;srand(42);int sizes[]={100,1000,10000};for(int z=0;z<3;z++)for(int mode=0;mode<4;mode++){int n=sizes[z];make(src,n,mode);Stats b={0},s={0},in={0};for(int i=0;i<n;i++)a[i]=src[i];bubble(a,n,&b);for(int i=0;i<n;i++)a[i]=src[i];selection(a,n,&s);for(int i=0;i<n;i++)a[i]=src[i];insertion(a,n,&in);printf("n=%d %-7s | Bubble cmp=%ld swaps=%ld | Selection cmp=%ld swaps=%ld | Insertion cmp=%ld shifts=%ld\n",n,names[mode],b.comparisons,b.swaps,s.comparisons,s.swaps,in.comparisons,in.shifts);}free(src);free(a);return 0;}
