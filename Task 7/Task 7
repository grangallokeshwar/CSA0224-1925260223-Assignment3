#include <stdio.h>
#include <stdlib.h>
#include <time.h>
typedef struct{int candidate;long count;} Result;
static int cmp(const void *x,const void *y){const Result*a=x,*b=y;if(a->count<b->count)return 1;if(a->count>b->count)return -1;return a->candidate-b->candidate;}
int main(void){int c;long v;if(scanf("%d%ld",&c,&v)!=2||c<1||c>12||v<1||v>500000)return 1;int *votes=malloc((size_t)v*sizeof *votes);long *count=calloc((size_t)c,sizeof *count);Result *r=malloc((size_t)c*sizeof *r);if(!votes||!count||!r){free(votes);free(count);free(r);return 1;}for(long i=0;i<v;i++)if(scanf("%d",&votes[i])!=1){free(votes);free(count);free(r);return 1;}long valid=0,invalid=0;clock_t start=clock();for(long i=0;i<v;i++){int x=votes[i];if(x<1||x>c)invalid++;else{count[x-1]++;valid++;}}for(int i=0;i<c;i++){r[i].candidate=i+1;r[i].count=count[i];}qsort(r,(size_t)c,sizeof *r,cmp);double secs=(double)(clock()-start)/CLOCKS_PER_SEC;printf("Valid votes: %ld\nInvalid votes: %ld\nVotes by candidate (descending):\n",valid,invalid);for(int i=0;i<c;i++)printf("Candidate %d: %ld\n",r[i].candidate,r[i].count);long max=r[0].count;int winners=0;for(int i=0;i<c;i++)if(r[i].count==max)winners++;if(winners==1)printf("Winner: Candidate %d\nTie: No\n",r[0].candidate);else{printf("Winner: Tie among");for(int i=0;i<winners;i++)printf(" Candidate %d",r[i].candidate);printf("\nTie: Yes\n");}printf("Processing time (count + result sort): %.6f seconds\n",secs);free(votes);free(count);free(r);return 0;}
