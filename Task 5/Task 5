#include <stdio.h>
#include <ctype.h>
int word_count(const char s[]){int count=0,inside=0;for(int i=0;s[i]!='\0';i++){if(isspace((unsigned char)s[i]))inside=0;else if(!inside){count++;inside=1;}}return count;}
int is_palindrome(const char s[]){int l=0,r=0;while(s[r]!='\0')r++;r--;while(l<r){while(l<r&&!isalpha((unsigned char)s[l]))l++;while(l<r&&!isalpha((unsigned char)s[r]))r--;if(tolower((unsigned char)s[l])!=tolower((unsigned char)s[r]))return 0;l++;r--;}return 1;}
int main(void){printf("Words: %d\n",word_count(" Meet at the library at 5 PM "));printf("%d %d\n",is_palindrome("Madam, I'm Adam"),is_palindrome("Hello"));printf("Tab-separated words: %d\n",word_count("one\ttwo"));return 0;}
